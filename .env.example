# ── Stripe ────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook secret – generate with: stripe listen --print-secret
# Or from https://dashboard.stripe.com/webhooks after adding an endpoint
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Printify ──────────────────────────────────────────
# API key: https://printify.com/app/account/connections
PRINTIFY_API_KEY=...

# Shop ID: run once → curl https://api.printify.com/v1/shops.json -H "Authorization: Bearer YOUR_API_KEY"
PRINTIFY_SHOP_ID=...

# ── Admin ─────────────────────────────────────────────
# Any secret string – used to protect the /api/admin/save-products endpoint
ADMIN_KEY=change-me-to-something-secret

# ── Server ────────────────────────────────────────────
PORT=3000
